# Formulize local Docker defaults
#
# Copy this file to .env to change any of these. You don't have to copy it by
# hand if all you want is the ports - the launcher script described below will
# create .env for you the first time you run it.
#
# Every setting here is optional. Blank means "use the default".

# By default, local development uses the published Docker Hub image (PHP 8.3).
# Leave this blank to use that image.
#
# Set this to a PHP version (e.g. 8.1, 8.2) to build and test that version
# locally instead, then run:
# docker compose up -d --build --force-recreate web
FORMULIZE_PHP_VERSION=

# Host ports for the web and database containers. Blank means 8080 and 3306.
#
# Only one thing at a time can hold a port, so two copies of Formulize can't
# both use 8080. Rather than picking ports yourself, start Formulize up with the
# launcher script for your system, from the root of the repository:
#
#   .\docker\up.ps1      (Windows, in PowerShell)
#   bash docker/up.sh    (macOS or Linux)
#
# It checks whether 8080 and 3306 are already taken (by another copy of
# Formulize, or anything else), counts upwards until it finds free ports, writes
# them here, and then starts Docker. So a second copy lands on 8081/3307, a third
# on 8082/3308, and so on.
#
# Because the ports are recorded here, each copy of Formulize keeps the same
# ports every time it starts, and plain "docker compose up" works from then on.
# You can also just set them yourself - the launcher only fills in blanks.
FORMULIZE_WEB_PORT=
FORMULIZE_DB_PORT=

# The address on your machine that those ports are published on. Blank means
# 127.0.0.1, so Formulize and its database are reachable only from this machine
# and not from anything else on your network. That is the safe default and most
# people should leave it alone.
#
# Set this to 0.0.0.0 if you need to reach Formulize from another device - a
# phone or tablet on the same wi-fi, or a colleague's machine, say:
#
#   FORMULIZE_BIND_HOST=0.0.0.0
#
# Be aware that this exposes the site AND the database, with their default
# development passwords, to everyone on the network you are attached to. Don't
# do it on a network you don't trust.
FORMULIZE_BIND_HOST=

# Docker Compose names its containers and its database volume after the folder
# this repository is in, which is usually what you want: two folders with
# different names are two separate projects with separate databases.
#
# Set this if your folder name clashes with another checkout, so that the two
# don't end up sharing one database. Blank means "use the folder name".
COMPOSE_PROJECT_NAME=
